---
// Bloque 6 · Que incluye el programa: los 8 modulos en bento, con "Resultado"
// como celda protagonista (ahi va el mockup del estado de resultados que se
// construye, Fase 5). Fuente unica de los modulos (A14): renombrar aca renombra
// en todo el sitio. Meses definidos por el dueño (A15, 07/09/2026).
import Eerr from '../mockups/Eerr.astro';
import Ficha from '../mockups/Ficha.astro';
import Caja from '../mockups/Caja.astro';
import Tablero from '../mockups/Tablero.astro';
// Fase 5: mockups de entregables en cuatro celdas (Resultado, Costeo, Agenda, Tablero).
const mockups = { 'mod-resultado': Eerr, 'mod-costeo': Ficha, 'mod-agenda': Caja, 'mod-tablero': Tablero };
const modulos = [
  { id: 'mod-resultado', nombre: 'Resultado', mes: 'mes 1', texto: 'El estado de resultados del mes: cuánto ganó el negocio de verdad, con gastos e impuestos descontados.', protagonista: true },
  { id: 'mod-registro', nombre: 'Registro', mes: 'mes 1', texto: 'La carga de ingresos y gastos: el dato de base con el que trabaja todo lo demás.' },
  { id: 'mod-costeo', nombre: 'Costeo', mes: 'mes 1 y 2', texto: 'Fichas de costo por producto, con merma incluida, y el precio que corresponde a cada uno.' },
  { id: 'mod-tablero', nombre: 'Tablero', mes: 'mes 1', texto: 'La vista visual del mes: los números que importan, de un vistazo.' },
  { id: 'mod-agenda', nombre: 'Agenda', mes: 'mes 2', texto: 'Vencimientos y pagos a la vista, para que ningún gasto grande agarre desprevenido al negocio.' },
  { id: 'mod-insumos', nombre: 'Insumos', mes: 'mes 2', texto: 'Análisis de proveedores y compras: qué se paga, a quién y cómo cambia mes a mes.' },
  { id: 'mod-bitacora', nombre: 'Bitácora', mes: 'desde el día 1', texto: 'Los acuerdos y cambios de cada sesión, anotados para volver a mirarlos.' },
  { id: 'mod-hoja-de-ruta', nombre: 'Hoja de ruta', mes: 'mes 3', texto: 'El plan de los tres meses y lo que sigue después: qué decidir, cuándo y con qué número.' },
];
---
<section id="que-recibis" class="bg-lienzo section">
  <div class="wrap">
    <div class="max-w-[60ch]" data-reveal>
      <p class="eyebrow text-marca">Qué te llevás</p>
      <h2 class="titular text-navy mt-4">Los módulos que quedan funcionando en tu negocio</h2>
      <p class="lead text-tinta-2 mt-6">Cada módulo trabaja con un dato concreto del negocio y queda en tus manos cuando termina el programa.</p>
    </div>
    <dl id="modulos" class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {modulos.map((m) => (
        <div id={m.id} class:list={['bg-superficie border border-borde rounded-xl p-6 flex flex-col gap-3', m.protagonista && 'md:col-span-2 md:row-span-2 lg:p-8']}>
          <dt class="flex items-baseline gap-3 m-0">
            <span class:list={['font-medium text-navy', m.protagonista ? 'subtitular' : 'text-[19px]']}>{m.nombre}</span>
            <span class="eyebrow text-tinta-3 normal-case tracking-[0.06em]">{m.mes}</span>
          </dt>
          <dd class="m-0 text-tinta-2">{m.texto}</dd>
          {mockups[m.id] && (() => { const M = mockups[m.id]; return <dd class="m-0 mt-5 pt-5 border-t border-borde-soft"><M /></dd>; })()}
        </div>
      ))}
    </dl>
  </div>
</section>
