---
// Bloque 12 · El diagnostico: es el CTA. Resultado de ejemplo (22/36, escala
// 3-9 en los medidores, como fija la fase 1) y los cuatro eslabones con su
// pregunta. El overlay con las 12 preguntas, el puntaje y el envio del lead se
// porta en la Fase 3 (misma logica, cero cambios): hasta entonces, el CTA lleva
// a esta seccion. El id "diagnostico" mantiene /#diagnostico como URL de entrada.
import { CTA_TEXTO } from '../../data/site';

// Medidores: arco de 251,33 (r=80); escala real 3–9 (todas C = arco vacio).
const arco = 251.33;
const offset = (score: number) => (arco * (1 - (score - 3) / 6)).toFixed(2);
const celdas = [
  { nombre: 'Costos', score: 8, estado: 'ok', label: 'Sólido', color: 'var(--color-positivo)' },
  { nombre: 'Resultado', score: 5, estado: 'warn', label: 'A mejorar', color: 'var(--color-alerta)' },
  { nombre: 'Caja', score: 3, estado: 'crit', label: 'Crítico', color: 'var(--color-riesgo)', debil: true },
  { nombre: 'Gestión', score: 6, estado: 'warn', label: 'A mejorar', color: 'var(--color-alerta)' },
];
const eslabones = [
  { num: '01', titulo: 'Costos y precios', pregunta: '¿El precio deja ganancia real? ¿Cada cosa que vendés tiene su costo exacto, o el costo se calcula a ojo?' },
  { num: '02', titulo: 'Resultado económico', pregunta: '¿Cuánto ganó el negocio el mes pasado? No cuánto facturó: cuánto quedó de verdad.' },
  { num: '03', titulo: 'Flujo de caja', pregunta: '¿Hay plata disponible cuando hace falta? Un negocio rentable también puede quedarse sin caja.' },
  { num: '04', titulo: 'Indicadores de gestión', pregunta: '¿Las decisiones salen de tus propios números o de la intuición? Sin indicadores, cada decisión importante es una apuesta.' },
];
---
<section id="diagnostico" class="section scroll-mt-20">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16 lg:items-center">
    <div class="lg:col-span-6">
      <p class="eyebrow text-marca">El diagnóstico · paso 1 del programa</p>
      <h2 class="titular text-navy mt-4">En 3 minutos sabés por dónde se le escapa la plata a tu negocio</h2>
      <p class="lead text-tinta-2 mt-6">12 preguntas sobre cómo se maneja el negocio hoy, sin planillas ni números difíciles. Al terminar ves el puntaje, el estado de cada eslabón, cuál es el más débil y qué hacer primero.</p>
      <button type="button" class="btn mt-8 w-full sm:w-auto" data-origen="diagnostico" onclick="if (window.openDiagnostico) openDiagnostico('diagnostico')">{CTA_TEXTO} <span aria-hidden="true">→</span></button>
      <p class="text-[14px] text-tinta-3 mt-4">Gratis, al instante, sin planillas.</p>
    </div>

    <!-- Resultado de ejemplo: hoja de informe, sin marco de navegador ni sombra. -->
    <div class="lg:col-span-6 bg-superficie border border-borde rounded-xl p-5 md:p-6" aria-label="Ejemplo del resultado del diagnóstico: puntaje 22 de 36, estado de los cuatro eslabones, eslabón más débil flujo de caja.">
      <p class="eyebrow text-tinta-3">Ejemplo de resultado</p>
      <div class="mt-4 bg-navy text-superficie rounded-lg px-5 py-4 flex items-end justify-between gap-4">
        <div>
          <p class="cifra font-medium leading-none text-[52px] m-0">22<span class="text-[18px] text-secondary-dark ml-1">/36</span></p>
          <p class="eyebrow text-secondary-dark mt-2">Puntaje total</p>
        </div>
        <span class="eyebrow bg-alerta-bg text-alerta rounded-full px-3 py-1.5 before:hidden">En desarrollo</span>
      </div>
      <div class="mt-3 grid grid-cols-4 gap-2">
        {celdas.map((c) => (
          <div class:list={['border rounded-lg px-1.5 py-3 text-center', c.debil ? 'border-riesgo' : 'border-borde']}>
            <p class="eyebrow text-navy justify-center before:hidden text-[10px]">{c.nombre}</p>
            <svg viewBox="-4 0 208 116" class="w-full max-w-[84px] mx-auto mt-2" aria-hidden="true">
              <path d="M 20,100 A 80,80 0 0,1 180,100" fill="none" stroke="var(--color-lienzo-2)" stroke-width="14" stroke-linecap="round"/>
              <path d="M 20,100 A 80,80 0 0,1 180,100" fill="none" stroke={c.color} stroke-width="14" stroke-linecap="round" stroke-dasharray={arco} stroke-dashoffset={offset(c.score)}/>
              <text x="100" y="95" text-anchor="middle" font-size="44" font-weight="500" fill="var(--color-navy)">{c.score}</text>
            </svg>
            <p class="eyebrow justify-center before:hidden text-[10px] mt-1" style={`color:${c.color}`}>{c.label}</p>
          </div>
        ))}
      </div>
      <p class="mt-4 text-[14px] text-tinta-2 m-0"><span class="eyebrow text-riesgo block mb-1">Eslabón más débil</span>Flujo de caja · el negocio es rentable en el papel, pero la plata no está cuando hace falta</p>
      <p class="eyebrow text-tinta-3 mt-4 before:hidden">Datos de ejemplo</p>
    </div>

    <ol class="lg:col-span-12 list-none m-0 p-0 mt-4 grid gap-8 md:grid-cols-2 lg:grid-cols-4 border-t border-borde">
      {eslabones.map((e) => (
        <li class="pt-5 md:pr-6">
          <span class="cifra text-[15px] font-medium text-marca">{e.num}</span>
          <h3 class="subtitular text-navy mt-2 m-0">{e.titulo}</h3>
          <p class="text-tinta-2 mt-2 m-0">{e.pregunta}</p>
        </li>
      ))}
    </ol>
    <p class="lg:col-span-12 text-tinta-2 m-0 max-w-[60ch]">12 preguntas, tres por eslabón, sobre cómo se maneja el negocio hoy. El diagnóstico recorre la cadena completa: dónde nace la ganancia, dónde se mide, dónde se convierte en plata y cómo se usa para decidir. El eslabón más débil es el que manda, y es por donde arranca el programa.</p>
  </div>
</section>
