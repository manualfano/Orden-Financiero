---
// Bloque 14 · CTA final: vuelve el canvas oscuro, cierre simetrico con el hero.
import { CTA_TEXTO, CTA_HREF } from '../../data/site';
---
<section id="cta-final" class="on-dark canvas-marca text-superficie section">
  <div class="wrap text-center grid justify-items-center gap-6" data-reveal>
    <h2 class="titular max-w-[18ch]">¿Por dónde se le escapa la plata a tu negocio?</h2>
    <p class="lead text-secondary-dark">12 preguntas, 3 minutos, gratis. El paso 1 del programa.</p>
    <a href={CTA_HREF} class="btn btn-white w-full sm:w-auto" data-origen="cta-final">{CTA_TEXTO} <span aria-hidden="true">→</span></a>
    <p class="text-[14px] text-secondary-dark">Sin planillas · Sin compromiso</p>
  </div>
</section>
